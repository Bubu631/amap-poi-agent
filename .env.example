# 高德地图 MCP（必填）
AMAP_MAPS_API_KEY=你的高德Key
# MCP 连接方式：sse（默认，直连 https://mcp.amap.com/sse）或 stdio（本地 npx @amap/amap-maps-mcp-server）
AMAP_MCP_MODE=sse

# 大模型（OpenAI 兼容接口；不填则自动降级为规则规划器）
LLM_API_KEY=
LLM_API_BASE_URL=https://api.zhizengzeng.com/v1
LLM_CHAT_PATH=/chat/completions
LLM_MODEL=gpt-5.6-luna
LLM_TIMEOUT=60
